{
  "mcpServers": {
    "sonarqube": {
      "command": "npx",
      "args": ["-y", "@sonarsource/sonarqube-mcp-server"],
      "env": {
        "SONARQUBE_URL": "https://your-sonar.example.com",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}"
      }
    }
  }
}
