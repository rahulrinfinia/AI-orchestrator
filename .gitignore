# Cloned application repos (each has its own git history)
/projects/*/

# Keep directory structure
!projects/.gitkeep

# Design / mockup assets (large binaries — track links in prd/, not raw exports)
/mockups/**
!/mockups/.gitkeep
**/design/exports/

# Specs — only track subdirectories, not loose files in specs root
/specs/*
!/specs/*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Cursor — user-specific (machine-local)
.cursor/projects/

# Environment
.env
.env.local
.env.*.local

# Node / Python (workspace scripts only)
node_modules/
__pycache__/
*.pyc
.venv/
