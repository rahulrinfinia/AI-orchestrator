# Cloned app repos live under projects/<name>/ — each has its own .git inside.
# Hub git does not track clone contents (nested repo); files stay VISIBLE in Cursor.
# Do not `git add projects/` from the hub.

# Keep hub docs in projects/
!projects/README.md

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Env
.env
.env.local

# Node / Python (workspace scripts)
node_modules/
__pycache__/
.venv/
